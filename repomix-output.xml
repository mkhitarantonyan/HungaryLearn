            >
              <LogOut className="w-4 h-4" />
              <span>Выйти из режима Администратора</span>
            </button>
          </div>
        ) : (
          <div className="my-4">
            <AdminLoginForm
              onSuccess={() => {
                onSuccess?.();
                onClose();
              }}
            />
          </div>
        )}
      </motion.div>
    </div>
  );
};
