    questions: [q('r1'), q('r2')],
    passCount: 5,
  };
  assert.ok(validateActivity(badReading).some((e) => e.includes('passCount')));

  const badListening: LessonActivity = {
    kind: 'listening',
    id: 'bad-listening',
    assetId: 'x',
    audioStatus: 'missing',
    transcript: 't',
    questions: [q('l1')],
    passCount: 0,
