} else {
  console.log('✅ Регистр везде совпадает');
}

console.log('\n=== Проверка венгерской диакритики ===');
const huFiles = wordFiles.filter(f => /[őóúéáíöüŐÓÚÉÁÍÖÜ]/.test(f));
