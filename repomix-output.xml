            </>
          ) : (
            <>
              <Lock className="w-3.5 h-3.5" />
              Только для подписчиков
            </>
          )}
        </span>
        <ChevronRight className="w-4 h-4 transform group-hover:translate-x-1 transition-transform" />
      </div>
    </motion.div>
  );
}

/* ---- Section wrapper ---- */
function LevelSection({
  levelLabel,
  levelTitle,
  lessons,
  accent,
  isAccessibleFn,
  onSelect,
  onLockedClick,
}: {
