  LESSON_1,
  L1_READ_ALOUD_WORDS,
  L1_SOFT_CONSONANT_LISTENING_TOKENS,
  L1_S_SZ_LISTENING_TOKENS,
  L1_VOWEL_LISTENING_TOKENS,
} from '../src/data/lessons/lesson1.ts';
