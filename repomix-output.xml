<script>
const logEl = document.getElementById('log');
function log(msg) {
  const time = new Date().toLocaleTimeString();
  logEl.textContent += `[${time}] ${msg}\n`;
  logEl.scrollTop = logEl.scrollHeight;
  console.log(msg);
}
log('=== Диагностика запущена ===');
log('User Agent: ' + navigator.userAgent);
log('speechSynthesis supported: ' + ('speechSynthesis' in window));

// Preload voices
if ('speechSynthesis' in window) {
  window.speechSynthesis.getVoices();
  window.speechSynthesis.addEventListener('voiceschanged', () => {
    log('Voices loaded: ' + window.speechSynthesis.getVoices().length + ' голосов');
  });
}

function testMp3() {
  log('--- Test MP3: /audio/1.1.mp3 ---');
  try {
    const audio = new Audio('/audio/1.1.mp3');
    audio.preload = 'auto';
    audio.oncanplaythrough = () => log('MP3 can play through, duration: ' + audio.duration + 's');
    audio.onplay = () => log('MP3 playback STARTED');
    audio.onended = () => log('MP3 playback ENDED');
    audio.onerror = (e) => log('MP3 ERROR: code=' + audio.error?.code + ' (1=ABORTED,2=NETWORK,3=DECODE,4=NOT_FOUND)');
    audio.onstalled = () => log('MP3 stalled');
    audio.onwaiting = () => log('MP3 waiting for data');
    log('Calling audio.play()...');
    const p = audio.play();
    if (p !== undefined) {
      p.then(() => log('MP3 play() promise RESOLVED — playback should start'))
       .catch(err => log('MP3 play() promise REJECTED: ' + err.name + ' — ' + err.message));
    } else {
      log('MP3 play() returned undefined (old browser)');
    }
  } catch(e) {
    log('MP3 exception: ' + e.message);
  }
}

async function testMp3Fetch() {
  log('--- Fetch HEAD /audio/1.1.mp3 ---');
  try {
    const res = await fetch('/audio/1.1.mp3', { method: 'HEAD' });
    log('HTTP ' + res.status + ' | Content-Type: ' + res.headers.get('content-type') + ' | Size: ' + res.headers.get('content-length'));
  } catch(e) {
    log('Fetch FAILED: ' + e.message);
  }
}

function testTTS(lang, text) {
  log('--- Test TTS: lang=' + lang + ' text="' + text + '" ---');
  if (!('speechSynthesis' in window)) {
    log('TTS NOT SUPPORTED in this browser!');
    return;
  }
  window.speechSynthesis.cancel();
  setTimeout(() => {
    const u = new SpeechSynthesisUtterance(text);
    u.lang = lang;
    u.rate = 0.85;
    const voices = window.speechSynthesis.getVoices();
    const langVoices = voices.filter(v => v.lang.toLowerCase().startsWith(lang.slice(0,2)));
    log('Available ' + lang + ' voices: ' + langVoices.map(v => v.name).join(', ') || 'NONE');
    if (langVoices.length > 0) {
      u.voice = langVoices[0];
      log('Using voice: ' + langVoices[0].name);
    } else {
      log('WARNING: No ' + lang + ' voice found, using default');
    }
    u.onstart = () => log('TTS STARTED');
    u.onend = () => log('TTS ENDED');
    u.onerror = (e) => log('TTS ERROR: ' + e.error);
    log('Calling speechSynthesis.speak()...');
    window.speechSynthesis.speak(u);
    log('speak() called, speaking=' + window.speechSynthesis.speaking + ' pending=' + window.speechSynthesis.pending);
  }, 100);
}

function showVoices() {
  log('--- All available voices ---');
  if (!('speechSynthesis' in window)) { log('NOT SUPPORTED'); return; }
  const voices = window.speechSynthesis.getVoices();
  log('Total voices: ' + voices.length);
  voices.forEach((v, i) => {
    log(`  [${i}] ${v.name} | lang=${v.lang} | ${v.localService ? 'local' : 'remote'} | ${v.default ? 'DEFAULT' : ''}`);
  });
  if (voices.length === 0) log('NO VOICES AVAILABLE — TTS will not work!');
}

async function testApi() {
  log('--- Fetch /api/audio-registry ---');
  try {
    const res = await fetch('/api/audio-registry');
    const data = await res.json();
    log('HTTP ' + res.status + ' | success=' + data.success + ' | entries=' + Object.keys(data.audio || {}).length);
    if (data.audio) {
      Object.entries(data.audio).slice(0, 5).forEach(([k,v]) => log('  ' + k + ' -> ' + v.url));
    }
  } catch(e) {
    log('API fetch FAILED: ' + e.message);
  }
}
