function legacyChoiceQuestions(
  listening: Extract<LessonActivity, { kind: 'listening' }>
): ReadingQuestion[] {
  const questions = listening.questions.filter(
    (question): question is ReadingQuestion => !isListeningTextInputQuestion(question)
  );
