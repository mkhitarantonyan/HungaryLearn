    'l5-cp-month-order',
    'l5-roleplay-schedule',
  ]);
  const evidence = {
    'l5-cp-weekday-order': directEvidence('l5-cp-weekday-order'),
    'l5-cp-month-order': directEvidence('l5-cp-month-order'),
    'l5-roleplay-schedule': rolePlayCompletionEvidence('l5-roleplay-schedule'),
  };
