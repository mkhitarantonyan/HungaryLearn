      </header>

      {/* Due review surfacing */}
      {dueReviewCount > 0 && (
        <div className="bg-[#2C5F58]/10 border-b border-[#2C5F58]/20 px-4 md:px-8 py-2.5">
          <div className="max-w-6xl mx-auto flex items-center gap-2.5 text-sm text-[#2C5F58] font-medium">
            <RefreshCw className="w-4 h-4 shrink-0" />
            <span>{dueReviewCount} карточек к повторению — откройте урок, чтобы начать разминку.</span>
          </div>
