    <section>
      <div className="flex items-center gap-3 mb-6 pb-2 border-b-2 border-[#7A1E2B]/20">
        <div className="px-3 py-1 bg-[#7A1E2B] text-white rounded-md font-mono font-bold text-xs uppercase tracking-wider">
