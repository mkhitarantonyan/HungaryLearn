# Non-secret Firebase Functions parameters.
# Local emulator: copy to functions/.env.local and use TEST Lemon resource IDs with TEST_MODE=true.
# Production: Firebase CLI will prompt for these at deploy time and save them to functions/.env.hungarylearn.
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
APP_URL=https://hungarylearn.web.app
LEMONSQUEEZY_TEST_MODE=false

# DO NOT put these secrets in this file:
# LEMONSQUEEZY_API_KEY
# LEMONSQUEEZY_WEBHOOK_SECRET
# Set them with: firebase functions:secrets:set <NAME>
