# Optional non-secret Firebase Functions parameters.
# Core/admin deployment does not require Lemon Squeezy configuration.
# Local emulator: copy to functions/.env.local and use TEST Lemon resource IDs with TEST_MODE=true.
# Billing production: set the final LIVE Store/Variant values and keep TEST_MODE=false.
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
APP_URL=https://hungarylearn.web.app
LEMONSQUEEZY_TEST_MODE=false

# Billing-only secrets. The core `api` Function does not bind these.
# DO NOT put secret values in this file:
# LEMONSQUEEZY_API_KEY
# LEMONSQUEEZY_WEBHOOK_SECRET
# Set them only before billing deploy with: firebase functions:secrets:set <NAME>
