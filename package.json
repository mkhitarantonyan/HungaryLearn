{
  "name": "hungarylearn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:manifest": "tsx scripts/generate-audio-manifest.ts",
    "predev": "npm run generate:manifest",
    "prebuild": "npm run export:vocabulary && npm run generate:manifest",
    "dev": "vite",
    "emulators": "firebase emulators:start",
    "build": "vite build",
    "postbuild": "tsx scripts/verify-public-bundle.ts",
    "functions:build": "node scripts/build-functions.mjs",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "firebase:set-admin": "tsx scripts/set-firebase-admin.ts",
    "audit:legacy": "tsx scripts/audit-legacy.ts",
    "test:rules": "firebase emulators:exec --project hungarylearn-rules-test --only firestore \"tsx --test tests/rules/firebaseRules.test.ts\"",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint .",
    "test": "tsx --test tests/*.test.ts",
    "validate:lessons": "tsx scripts/validateLessons.ts",
    "export:listening": "tsx scripts/export-listening-plan.ts",
    "validate:listening": "tsx scripts/validateListeningAudio.ts",
    "export:vocabulary": "tsx scripts/export-vocabulary.ts",
    "validate:vocabulary": "tsx scripts/validateVocabulary.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.13",
    "firebase": "^12.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.2.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
