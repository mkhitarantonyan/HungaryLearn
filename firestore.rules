rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if owns(uid) || admin();
      allow create, update, delete: if false;
    }
    match /entitlements/{uid} {
      allow read: if owns(uid) || admin();
      allow write: if false;
    }
    match /progress/{uid} {
      allow read: if owns(uid) || admin();
      // Progress integrity is enforced by authenticated Functions transactions.
      // Browser SDK writes (including writes to one's own document) are forbidden.
      allow write: if false;
    }
    match /billingSubscriptions/{document=**} { allow read, write: if false; }
    match /billingWebhookEvents/{document=**} { allow read, write: if false; }
    match /accountDeletions/{document=**} { allow read, write: if false; }
    match /organizations/{document=**} { allow read, write: if false; }
    match /organizationLicenses/{document=**} { allow read, write: if false; }
    match /organizationSeats/{document=**} { allow read, write: if false; }
    match /organizationAccessKeys/{document=**} { allow read, write: if false; }
    match /organizationAuditLogs/{document=**} { allow read, write: if false; }
    match /organizationRedeemLimits/{document=**} { allow read, write: if false; }
    match /organizationSeatGuards/{document=**} { allow read, write: if false; }
    match /audioOverrides/{document=**} { allow read, write: if false; }
    match /wordOverrides/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
