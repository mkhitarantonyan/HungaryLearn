# Firebase Web SDK configuration (public client identifiers, not Admin credentials).
# Copy to .env.local for local/Vite builds and fill from Firebase Console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hungarylearn.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hungarylearn
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# npm run dev:full supplies an isolated demo project config and overrides this to true.
# These values remain for production builds and production-like preview commands.
VITE_USE_FIREBASE_EMULATORS=false
