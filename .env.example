# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN credentials (server-side authentication)
# Put the real values in the local .env file.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Required in production — generate with: npx bcryptjs hash "your-password"
ADMIN_PASSWORD_HASH=

# Stripe Payments Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# PostgreSQL connection string from the approved Supabase project's Connect panel.
# For a persistent server, use Direct Connection when IPv6 is available or
# Supavisor Session mode when the host is IPv4-only. Keep this server-side.
DATABASE_URL=

# Server-side Supabase Storage configuration. Never expose the service-role key
# through a VITE_ variable or commit its real value.
SUPABASE_URL=https://qkinyuxousscqgvjvrin.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=hungarylearn-audio-overrides
SUPABASE_COURSE_AUDIO_BUCKET=hungarylearn-course-audio

# Public static course-audio base. Leave empty to use public/audio locally.
# After running and verifying `npm run audio:migrate`, staging should use:
# https://qkinyuxousscqgvjvrin.supabase.co/storage/v1/object/public/hungarylearn-course-audio/audio
VITE_AUDIO_BASE_URL=

# Express server port.
PORT=3000
