# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN credentials (server-side authentication)
# Put the real values in the local .env file.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: Store password hash instead of plaintext password (e.g. generated with bcrypt)
ADMIN_PASSWORD_HASH=

# Stripe Payments Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ============================================
# Google Cloud Storage (optional, for audio files)
# ============================================
# When set, all slide narration & word audio are served from GCS instead of
# the local /public/audio/ folder. This dramatically reduces repo & build size.
#
# Create a bucket: gsutil mb gs://my-hungarian-audio-bucket
# Upload once:        node scripts/uploadAudioToGCS.mjs
# After upload:       remove /public/audio/*.mp3 and restart.
#
# GCS_BUCKET=my-hungarian-audio-bucket
# GCS_PROJECT_ID=my-gcp-project-123
# GCS_KEY_FILE=./gcs-service-account.json  (path to your service-account JSON)

# When VITE_AUDIO_BASE_URL is set, the app uses it as the base for all
# /audio/... URLs (e.g. https://storage.googleapis.com/my-hungarian-audio-bucket/audio)
# Leave empty for local development (served from /public/audio/).
VITE_AUDIO_BASE_URL=
